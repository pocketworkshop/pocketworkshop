{
  "name": "pocketworkshop",
  "compatibility_date": "2026-09-26",
  "main": "./worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/tools",
      "/tools.html",
      "/about",
      "/about.html",
      "/privacy",
      "/privacy.html",
      "/terms",
      "/terms.html",
      "/tools/*",
      "!/tools/*.js"
    ]
  }
}
